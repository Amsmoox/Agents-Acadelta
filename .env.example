# ---- Database ----
# Port 5433 on the host so it never collides with a local Postgres on 5432.
DATABASE_URL=postgres://agentco:agentco@localhost:5433/agentco

# ---- API ----
API_PORT=4100
API_HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# ---- Web ----
VITE_API_URL=http://localhost:4100

# ---- Runner ----
# Where detached agent processes write their append-only transcripts.
RUN_TRANSCRIPT_DIR=./var/run-transcripts
# Dispatcher poll interval (ms) and lease/heartbeat tuning.
DISPATCH_POLL_INTERVAL_MS=1500
RUN_LEASE_SECONDS=30
RUN_HEARTBEAT_INTERVAL_MS=7000

# ---- Object storage (MinIO locally, S3-compatible in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agentco-transcripts
S3_ACCESS_KEY_ID=agentco
S3_SECRET_ACCESS_KEY=agentco123
S3_FORCE_PATH_STYLE=true
